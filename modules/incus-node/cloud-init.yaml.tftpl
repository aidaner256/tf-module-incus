#cloud-config
users:
  - name: ${init_user}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_key}
package_update: ${package_update}
packages: ${jsonencode(packages_install)}
runcmd: ${jsonencode(runcmd)}
timezone: ${timezone}
write_files: ${jsonencode(write_files)}
